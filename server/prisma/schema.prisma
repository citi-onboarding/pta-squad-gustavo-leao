// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
 id        Int    @id @default(autoincrement())
 firstName String
 lastName  String
 age       Int
}


enum Category {
 Romance
 Infantil
 Tecnologia
 Historia
 Ciencias
}


enum LoanStatus {
 EmAndamento
 Devolvido
 Atrasado
}


model Book {
  id           String   @id @default(uuid())
  title        String
  author       String
  isbn         String   @unique
  publisher    String
  year         Int
  totalQty     Int
  availableQty Int
  category     Category
  cover        String
  loans        Loan[]
}


model Loan {
 id             String   @id @default(uuid())
 bookId         String
 clientName     String
 clientEmail    String  
 rentalDate     DateTime
 expectedReturn DateTime
 status         LoanStatus


 book           Book     @relation(fields: [bookId], references: [id])
}

